4193ed873e1dc","char":"𨲦","codepoint":"U+28CA6","strokeCount":18,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e1f7","char":"𨳁","codepoint":"U+28CC1","strokeCount":23,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e1f9","char":"𨳃","codepoint":"U+28CC3","strokeCount":24,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e201","char":"𨳋","codepoint":"U+28CCB","strokeCount":10,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e202","char":"𨳌","codepoint":"U+28CCC","strokeCount":10,"simpVariants":["𰿦"],"sources":["academia-sinica","unicode"],"images":[{"url":"https://data.dong-chinese.com/img/sinica/%F0%A8%B3%8C_0.png","source":"academia-sinica","description":"說文‧門部","type":"Seal","era":"Shuowen (~100 AD)"}],"shuowen":"《說文》：“，登也。從門、。，古文下字。讀若軍敶之敶。”","comments":[{"source":"academia-sinica","text":"徐鉉曰：“下，言自下而登上也。”林義光《文源》：“下門者，其下為門，登高之象。”段玉裁、嚴可均、于鬯等據《六書故》引唐本《說文》和《說文．隹部》籀文“𨶄”字改𠄟（下）為𠄞（上）。于鬯《說文職墨》：“从𠄞門者，从上門也。上門者，上聞也。上聞則有進升之義，故訓為登。上文云門，聞也。此字从門，但取聞字之義，與他字从門戶之門者不同。若亦以此為門戶之門，則門上惟有楣耳，亦非可以登者，於訓登義何涉？”"}],"variants":[{"char":"𨳌","parts":"𠄟門","source":"academia-sinica"}]},{"_id":"5f523b00de54193ed873e147","char":"𨰑","codepoint":"U+28C11","strokeCount":26,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e14b","char":"𨰕","codepoint":"U+28C15","strokeCount":26,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e14f","char":"𨰙","codepoint":"U+28C19","strokeCount":26,"sources":["unicode"]},{"_id":"5f523b00de54193ed873e15b","char":"𨰥","codepoint":"U+28C25","strokeCount":27,"simpVariants":["𫔕"],"sources":["unicode"]},{"_id":"5f523b00de54193ed873e168","char":"𨰲","codepoint":"U+28C32","strokeCount":29,"simpVariants":["𫔃"],"sources":["unicode"]},{"_id":"5f523b00de54193ed873e16f","char":"𨰹","codepoint":"U+28C39","strokeCount":30,"simpVariants":["𰿀"],"sources":["unicode"]},{"_id":"5f523b00de54193ed873e17a","char":"𨱄","codepoint":"U+28C44","strokeCount":10,"tradVariants":["鈯"],"sources":["unicode"]},{"_id":"5f523b00de54193ed873e196","char":"𨱠","codepoint":"U+28C60","strokeCount":11,"so