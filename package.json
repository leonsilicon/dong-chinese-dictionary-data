{
  "name": "dong-chinese-dictionary-data",
  "version": "1.20251225.0",
  "description": "Chinese dictionary data from dong-chinese.com, packaged as a single JSON file with TypeScript types.",
  "keywords": [
    "chinese",
    "cjk",
    "data",
    "dictionary",
    "dong-chinese",
    "hanzi",
    "json",
    "mandarin"
  ],
  "homepage": "https://github.com/leonsilicon/dong-chinese-dictionary-data#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/dong-chinese-dictionary-data/issues"
  },
  "license": "MIT",
  "author": "leonsilicon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/dong-chinese-dictionary-data.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "character-data.d.ts",
    "unicode-entry.d.ts",
    "unicode"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./unicode/*": {
      "types": "./unicode-entry.d.ts",
      "default": "./unicode/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run scripts/parse.ts",
    "test": "vp test",
    "check": "vp check",
    "prepack": "bun run scripts/parse.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "js-jsonl": "^1.1.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13"
}
